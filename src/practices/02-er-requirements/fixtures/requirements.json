{
  "requiredEntities": ["Student", "Professor", "Department", "Course"],
  "requiredAttributes": {
    "Student": ["id", "name", "studentNumber"],
    "Professor": ["id", "name", "departmentId"],
    "Department": ["id", "name"],
    "Course": ["id", "title", "professorId"]
  },
  "requiredRelationships": [
    { "name": "belongsTo", "from": "Professor", "to": "Department" },
    { "name": "teaches", "from": "Professor", "to": "Course" },
    { "name": "enrolls", "from": "Student", "to": "Course" }
  ]
}
