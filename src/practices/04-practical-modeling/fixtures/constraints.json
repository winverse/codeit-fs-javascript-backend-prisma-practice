{
  "entities": [
    "Customer",
    "Booking",
    "Ticket",
    "Screening",
    "Movie",
    "Theater",
    "Seat"
  ],
  "relations": [
    "Customer ||--o{ Booking",
    "Booking ||--|{ Ticket",
    "Screening ||--o{ Ticket",
    "Seat ||--o{ Ticket",
    "Movie ||--o{ Screening",
    "Theater ||--o{ Screening",
    "Theater ||--|{ Seat"
  ],
  "requiredFields": {
    "Customer": ["id", "name", "email"],
    "Booking": ["id", "customerId", "bookingTime"],
    "Ticket": ["id", "bookingId", "screeningId", "seatId"],
    "Screening": ["id", "movieId", "theaterId", "showtime"],
    "Movie": ["id", "title", "durationInMinutes"],
    "Theater": ["id", "name", "totalSeats"],
    "Seat": ["id", "theaterId", "seatNumber"]
  },
  "requiredKeyFields": {
    "Booking": ["customerId FK"],
    "Ticket": ["bookingId FK", "screeningId FK", "seatId FK"],
    "Screening": ["movieId FK", "theaterId FK"],
    "Seat": ["theaterId FK"]
  },
  "uniqueFields": ["Customer.email"],
  "uniqueConstraints": ["Seat(theaterId,seatNumber)"],
  "blog": {
    "entities": ["User", "Post", "Comment", "Tag"],
    "relations": [
      "User ||--o{ Post",
      "User ||--o{ Comment",
      "Post ||--o{ Comment",
      "Post }o--o{ Tag"
    ],
    "requiredFields": {
      "User": ["id", "email", "name"],
      "Post": ["id", "title", "content", "authorId"],
      "Comment": ["id", "content", "authorId", "postId"],
      "Tag": ["id", "name"]
    },
    "requiredKeyFields": {
      "Post": ["authorId FK"],
      "Comment": ["authorId FK", "postId FK"]
    },
    "uniqueFields": ["User.email", "Tag.name"]
  }
}
